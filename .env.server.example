# SuperMew 服务器环境配置模板
#
# 使用方法：复制为服务器项目目录中的 .env，再把所有 your_* 和 replace-with-* 占位值
# 换成真实配置。真实 .env 只能保存在服务器或本地受控环境中，不要提交到 Git。
#
# 服务器当前使用：云端 Milvus + MinerU 官方 API + 远程模型服务。
# PostgreSQL 和 Redis 由 docker-compose.prod.yml 启动，应用容器会自动使用 postgres、redis
# 这两个服务名连接它们。

# ==================== 模型服务 ====================
# OpenAI 兼容模型服务的访问密钥。聊天、拆题和判分模型共用这把密钥。
ARK_API_KEY=your_model_api_key

# 主模型：负责理解用户问题并生成最终回答。
MODEL=your_main_model

# 快速模型：负责判断问题是否复杂、拆分问题等较轻任务。
# 资源允许时可以和主模型相同；想降低速度和费用时可换成更小的模型。
FAST_MODEL=your_fast_model

# 判分模型：用于评测或判断资料是否足以支撑回答。
GRADE_MODEL=your_grade_model

# 模型服务的基础地址，只填写服务根地址，不要加 /chat/completions。
BASE_URL=https://api.siliconflow.cn/v1

# ==================== 向量和再次排序 ====================
# 使用远程向量服务，不在服务器下载本地向量模型。
EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=your_siliconflow_api_key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# BGE-M3 输出 1024 维向量；更换向量模型时必须同步修改并重新建集合。
DENSE_EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# 对第一次找到的资料再次排序，最终挑选更相关的资料给回答模型。
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
RERANK_BINDING_HOST=https://api.siliconflow.cn
RERANK_API_KEY=your_rerank_api_key
RERANK_TIMEOUT_SECONDS=5

# ==================== 资料查找 ====================
# 最后交给回答模型阅读的资料段数量。
RETRIEVAL_TOP_K=8
# 再次排序前先找出的候选资料数量，必须大于 RETRIEVAL_TOP_K。
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_CANDIDATE_MULTIPLIER=3
# 找到小段资料后，自动补回所属章节上下文。
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3
RERANK_MIN_SCORE=0.0

# ==================== 云端 Milvus / Zilliz Cloud ====================
# 云端 Milvus 的完整地址和访问令牌。服务器不启动本地 Milvus、etcd、MinIO 或 Attu。
MILVUS_URI=https://your-zilliz-endpoint
MILVUS_TOKEN=your_zilliz_token
MILVUS_COLLECTION=embeddings_collection
MILVUS_TIMEOUT=30

# ==================== PostgreSQL ====================
# 生产 Compose 使用这组配置创建 PostgreSQL，并自动为应用拼接 DATABASE_URL。
# 密码必须替换；数据库名和用户名可以按需要修改。
POSTGRES_DB=langchain_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# ==================== 登录安全 ====================
# 请替换成随机长字符串，不要使用示例值。
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_INVITE_CODE=replace-with-an-admin-invite-code
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000

# ==================== MinerU 官方 API ====================
# 服务器使用 MinerU 官方接口，不需要启动本地 Gradio MinerU。
MINERU_PROVIDER=official_api
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_KEY=your_mineru_api_key

# 官方接口轮询和重试设置。长 PDF 会按连续页码分批处理。
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_PAGE_BATCH_SIZE=200
MINERU_MAX_RETRIES=3
MINERU_API_TIMEOUT_SECONDS=600

# 一次上传最多接收的文件数，以及同时处理的文件数。
DOCUMENT_UPLOAD_MAX_FILES=10
DOCUMENT_UPLOAD_CONCURRENCY=2

# ==================== 可选功能 ====================
# 不使用天气工具时可以留空；使用时填写高德 API 密钥。
# AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
# AMAP_API_KEY=your_amap_api_key

# 需要把链路记录发送到 LangSmith 时再取消注释，并确认隐私要求。
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=SuperMew

# ==================== 可选评测配置 ====================
# 服务器只运行在线业务时不需要配置；在服务器执行独立评测时再填写。
# EVALUATION_CASE_TIMEOUT_SECONDS=600
# EVALUATION_DATABASE_URL=postgresql+psycopg2://postgres:replace-with-postgres-password@postgres:5432/enterprise_rag_evaluation
