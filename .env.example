# SuperMew 环境变量模板
# 请将本文件复制为 .env，再把所有 your_* 和 replace-with-* 占位值换成真实配置。
# 不要把复制后的 .env、真实密钥或密码提交到 Git。

# ==================== 模型服务 ====================
# OpenAI 兼容模型网关的 API 密钥，聊天、拆题和判分模型都会使用它。
# 当 MODEL、FAST_MODEL 或 GRADE_MODEL 使用需要鉴权的远程服务时必须填写。
ARK_API_KEY=your_model_api_key

# 主模型：负责生成最终回答，并决定使用哪些工具或 RAG 流程。
# 必须填写 BASE_URL 对应服务支持的准确模型名称。
MODEL=deepseek-ai/DeepSeek-V4-Flash

# 快速模型：负责复杂度判断、问题拆分等较轻的任务。
# 可以和主模型相同；使用更小、更快的模型可以降低延迟和费用。
FAST_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 判分模型：独立判断资料是否真正支持模型回答。
# 正式评测时建议与主模型分开，避免模型自己给自己判分。
GRADE_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 主模型、快速模型和判分模型共用的 OpenAI 兼容接口地址。
# 如果服务要求 /v1 路径，请保留；不要重复添加 /chat/completions 等具体接口路径。
BASE_URL=https://api.siliconflow.cn/v1

# ==================== 向量生成 ====================
# 向量生成方式。当前支持 siliconflow（远程接口）和 huggingface（本地模型）。
EMBEDDING_PROVIDER=siliconflow

# 使用 siliconflow 生成向量时所需的 API 密钥。
# 真实密钥只能放在本地或服务器上的 .env 中。
SILICONFLOW_API_KEY=your_siliconflow_api_key

# 远程向量接口地址；使用 huggingface 本地模型时会忽略此项。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# 向量模型名称。默认 BGE-M3 生成 1024 维向量。
# 更换模型时必须同步修改 DENSE_EMBEDDING_DIM，并重新建立 Milvus 集合。
EMBEDDING_MODEL=BAAI/bge-m3

# 向量模型输出的维度，必须和 Milvus 集合的字段定义完全一致。
DENSE_EMBEDDING_DIM=1024

# 每次远程请求或入库批处理包含的文本数量。
# 数值越大吞吐可能越高，但也会占用更多内存并受服务商请求限制影响。
EMBEDDING_BATCH_SIZE=32

# 单次向量请求最多等待多少秒，超时后该请求会被视为失败。
EMBEDDING_TIMEOUT_SECONDS=60

# 本地 Hugging Face 模型使用的设备，可填 cpu、cuda 等。
# 使用 siliconflow 远程向量服务时忽略此项。
EMBEDDING_DEVICE=cpu

# ==================== 二次排序 ====================
# 对第一次找出的资料重新排序的模型。
# 如果不需要二次排序，可以将相关三个变量留空或删除。
RERANK_MODEL=Qwen/Qwen3-Reranker-4B

# 二次排序服务的基础地址，代码会自动拼接服务需要的排序接口路径。
RERANK_BINDING_HOST=https://api.siliconflow.cn

# 二次排序服务的 API 密钥，只能写入真实运行环境中的 .env。
RERANK_API_KEY=your_rerank_api_key

# 单次二次排序请求最多等待多少秒。
RERANK_TIMEOUT_SECONDS=5

# ==================== 资料查找 ====================
# 最后交给回答模型阅读的资料段数量。
RETRIEVAL_TOP_K=8

# 二次排序前第一次找出的资料数量，通常应大于 RETRIEVAL_TOP_K。
RETRIEVAL_CANDIDATE_K=30

# 处理复杂问题或合并资料时，候选资料池扩大的倍数。
RETRIEVAL_CANDIDATE_MULTIPLIER=3

# 是否在找到小段资料后，自动补回所属的父级资料或章节上下文。
AUTO_MERGE_ENABLED=true

# 至少找到多少个相关小段后，才触发父级资料合并。
AUTO_MERGE_THRESHOLD=2

# 首先查找的资料层级；3 表示最小的叶子资料段。
LEAF_RETRIEVE_LEVEL=3

# 二次排序分数最低保留值。0.0 表示只要有有效分数就保留。
RERANK_MIN_SCORE=0.0

# ==================== Milvus、PostgreSQL、Redis ====================
# 云端 Milvus 或 Zilliz Cloud 的完整 HTTPS 地址。
# 留空时使用下面的 MILVUS_HOST 和 MILVUS_PORT 连接本地 Docker Milvus。
MILVUS_URI=

# 云端 Milvus 的访问令牌（相当于连接密码）。
# 本地未开启鉴权的 Milvus 留空；真实令牌只放在 .env，不要提交。
MILVUS_TOKEN=

# 本地 Milvus 的主机地址；只有 MILVUS_URI 留空时才会使用。
MILVUS_HOST=127.0.0.1

# Docker 映射到宿主机的 Milvus gRPC 端口；云端模式下不会使用。
MILVUS_PORT=19531

# 普通业务请求使用的 Milvus 集合名称。
# 正式评测必须使用独立集合，不能覆盖业务集合。
MILVUS_COLLECTION=embeddings_collection

# 单次 Milvus 操作最多等待多少秒。
MILVUS_TIMEOUT=30

# 业务 PostgreSQL 数据库连接地址，保存用户、文档和聊天等业务数据。
# 如果后端也运行在 Docker 中，应把 127.0.0.1 改成 Compose 服务名 postgres。
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:15432/langchain_app

# Redis 连接地址，用于缓存和临时运行状态。
# 如果后端也运行在 Docker 中，应把 127.0.0.1 改成 Compose 服务名 redis。
REDIS_URL=redis://127.0.0.1:16379/0

# ==================== 登录鉴权 ====================
# 用来签发 JWT 登录令牌的密钥，真实环境必须换成长随机字符串。
JWT_SECRET_KEY=replace-with-a-long-random-secret

# 创建或邀请管理员时需要填写的管理邀请码。
ADMIN_INVITE_CODE=replace-with-an-admin-invite-code

# JWT 使用的签名算法，目前后端按 HS256 处理。
JWT_ALGORITHM=HS256

# JWT 有效期，单位为分钟；1440 表示 24 小时。
JWT_EXPIRE_MINUTES=1440

# 密码 PBKDF2 加密的计算轮数，数值越大越安全，但登录和注册消耗的 CPU 也越多。
PASSWORD_PBKDF2_ROUNDS=310000

# ==================== Docker 宿主机端口 ====================
# 以下是宿主机端口，容器内部端口由 docker-compose.yml 固定。
# 只有宿主机端口冲突时才需要修改，并同步修改上面的连接地址。
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MILVUS_HOST_PORT=19531
MILVUS_HEALTH_HOST_PORT=19091
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
ATTU_HOST_PORT=18080

# ==================== 天气工具 ====================
# 可选天气工具使用的高德天气接口地址。
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo

# 高德天气 API 密钥；不使用天气功能时可以不配置。
AMAP_API_KEY=your_amap_api_key

# ==================== 可选 LangSmith 链路记录 ====================
# 只有明确需要把请求记录发送到 LangSmith 时才取消注释。
# 开启后可能会把问题、提示词和回答发送到外部服务，请先确认隐私要求。
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=SuperMew

# ==================== 评测 ====================
# 单道评测题允许的最长时间，包含资料查找、模型回答和判分。
EVALUATION_CASE_TIMEOUT_SECONDS=600

# 独立的评测 PostgreSQL 数据库连接地址。
# 不要把它指向业务数据库，避免评测记录污染正常业务数据。
EVALUATION_DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:15432/enterprise_rag_evaluation

# ==================== MinerU 文档解析 ====================
# 富文档解析方式。默认使用本地或自建的 MinerU Gradio 服务。
# 只有填写真实官方密钥后，才应改为 official_api。
MINERU_PROVIDER=gradio

# 使用 Gradio 模式时的 MinerU 服务地址。
# 该服务必须提前启动，项目本身不会自动启动 MinerU。
MINERU_URL=http://127.0.0.1:7860

# 传给 Gradio MinerU 服务的解析后端名称。
MINERU_BACKEND=hybrid-engine

# 传给 Gradio MinerU 服务的可选解析引擎地址。
MINERU_ENGINE_URL=http://localhost:30000

# 使用 official_api 模式时的 MinerU 官方 REST API 基础地址。
# 推荐使用 v4：支持 file-urls/batch、page_ranges 和更大的单文件页数。
# v1/agent 只作为兼容旧配置使用，单个 page_range 不能超过 20 页。
MINERU_API_BASE_URL=https://mineru.net/api/v4

# MinerU 官方 API 密钥，只能放在真实 .env 中，不能提交。
MINERU_API_KEY=your_mineru_api_key

# 要切换到官方云端 API，只需要把上面的 provider 改成：
# MINERU_PROVIDER=official_api

# 官方 API 查询解析任务状态的间隔，单位为秒。批量任务不要设置过小，避免触发接口限流。
MINERU_POLL_INTERVAL_SECONDS=5

# 一个长 PDF 每个解析批次处理的页数，单位为页，默认 200。
# 超过此页数会按连续页码分成多个批次；同一个文件的批次按顺序处理。
MINERU_PAGE_BATCH_SIZE=200

# 一次批量上传最多接收的文件数量。超过后整批拒绝，不会只接收前几个文件。
DOCUMENT_UPLOAD_MAX_FILES=10

# 批量任务同时处理的文件数量。默认 2；同一个长 PDF 的分页不会绕过此限制。
DOCUMENT_UPLOAD_CONCURRENCY=2

# MinerU 任务遇到网络错误、限流或服务端暂时错误时的最大重试次数。
MINERU_MAX_RETRIES=3

# 一个官方 API 任务从创建、上传、等待到下载结果允许的总等待时间，单位为秒。
MINERU_API_TIMEOUT_SECONDS=600

# ==================== 可选 MinerU 解析参数 ====================
# 以下参数会按当前解析方式支持的能力发送，不支持的参数会被忽略。

# PDF 最大解析页数（旧版单文件入口）；批量分页使用 MINERU_PAGE_BATCH_SIZE。
# MINERU_END_PAGES=1000

# 扫描版 PDF 或图片是否强制启用 OCR。
# MINERU_FORCE_OCR=false

# 是否识别数学公式。
# MINERU_FORMULA_ENABLE=true

# 是否识别表格。
# MINERU_TABLE_ENABLE=true

# Gradio 服务是否进行图片内容分析。
# MINERU_IMAGE_ANALYSIS=true

# Gradio MinerU 的处理强度，可按机器性能选择。
# MINERU_EFFORT=medium

# Gradio 使用的语言下拉选项；官方适配层会提取开头的语言代码。
# MINERU_LANGUAGE=ch (Chinese, English, Japanese, Chinese Traditional, Latin)
